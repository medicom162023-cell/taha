{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aard-figma-test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NEWS_CACHE",
      "id": "ba11526c35334779a9451f4cf533399f"
    }
  ],
  "d1_databases": [
    {
      "binding": "ASSISTANCE_DB",
      "database_name": "aard-assistance-test",
      "database_id": "4e3d9412-0cf0-429b-a337-f2ae2ae9c464"
    }
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "Info@aard.ps",
      "allowed_sender_addresses": ["noreply@aard.ps"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
